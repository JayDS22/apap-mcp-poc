# Required: OpenAI API key for function-calling against gpt-4o-mini.
OPENAI_API_KEY=sk-...

# Required: where the APAP REST server is reachable.
# Default if running the apap-mcp-poc locally via `docker compose up`.
APAP_BASE_URL=http://localhost:9000

# Optional: model to use. gpt-4o-mini is cheap + has good function-calling support.
# Other plausible options: gpt-4o, gpt-4.1-mini.
OPENAI_MODEL=gpt-4o-mini

# Optional: max turns the agent will take before giving up.
MAX_TURNS=8
