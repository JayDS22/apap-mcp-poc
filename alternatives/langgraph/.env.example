# Required: OpenAI API key (same key as the openai-fn-calling spike).
OPENAI_API_KEY=sk-...

# Required: where the APAP REST server is reachable.
APAP_BASE_URL=http://localhost:9000

# Optional: model. gpt-4o-mini is the same default the fn-calling spike uses,
# which keeps the comparison apples-to-apples.
OPENAI_MODEL=gpt-4o-mini

# Optional: cap on graph iterations before giving up.
MAX_ITERATIONS=10
